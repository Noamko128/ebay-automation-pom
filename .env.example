# Which config profile to run against (see config/config.yaml). "mock" is the default and
# recommended profile - it runs against the local mock eBay site bundled in mock_site/, so the
# suite is deterministic and never blocked by eBay's bot/CAPTCHA protection.
TEST_ENV=mock

# Overrides config/config.yaml's base_url for the selected profile, if set.
# BASE_URL=http://127.0.0.1:5057

# Playwright browser: chromium | firefox | webkit
BROWSER=chromium

# Run browsers headless (true) or headed (false) - headed is useful when demoing live.
HEADLESS=true
